diff --git a/lib/native-paths.js b/lib/native-paths.js
new file mode 100644
index 0000000000000000000000000000000000000000..b576f899e4016510c29df299b3635f1b3ef0b5ee
--- /dev/null
+++ b/lib/native-paths.js
@@ -0,0 +1,41 @@
+import { lstat, mkdtemp, rmdir, symlink, unlink } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, relative } from "node:path";
+
+/**
+ * Runs a native conversion through a conversion-owned engine junction.
+ * The operation must settle only after its helper exits. Cleanup never recursively
+ * removes the alias or the installed engine, including on cancellation or failure.
+ * @param engine Physical installed native engine paths.
+ * @param operation Async operation consuming the aliased paths.
+ * @returns The operation result after alias cleanup.
+ */
+export async function withNativeEngineAlias(engine, operation) {
+  const directory = await mkdtemp(join(tmpdir(), "lok-"));
+  const alias = join(directory, "e");
+  let linked = false;
+  let failure;
+  try {
+    await symlink(engine.root, alias, "junction");
+    linked = true;
+    return await operation({
+      ...engine,
+      root: alias,
+      programDirectory: join(alias, relative(engine.root, engine.programDirectory)),
+      executable: join(alias, relative(engine.root, engine.executable)),
+    });
+  } catch (error) {
+    failure = error;
+    throw error;
+  } finally {
+    try {
+      if (linked) {
+        if (!(await lstat(alias)).isSymbolicLink()) throw new Error("Native engine alias is no longer a link.");
+        await unlink(alias);
+      }
+      await rmdir(directory);
+    } catch (error) {
+      throw new AggregateError(failure === undefined ? [error] : [failure, error], "Native engine alias cleanup failed.");
+    }
+  }
+}
